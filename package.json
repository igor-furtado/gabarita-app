{
  "name": "gabarita",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "api:generate": "tsx scripts/openapi.ts && orval",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "@tanstack/vue-query": "^5.90.0",
    "@tanstack/vue-table": "^8.21.0",
    "@vueuse/core": "^14.0.0",
    "lucide-vue-next": "^0.468.0",
    "reka-ui": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "fastify": "^5.6.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/static": "^8.3.0",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.0",
    "dotenv": "^17.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "vue-tsc": "^3.0.0",
    "tsx": "^4.20.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.0",
    "orval": "^7.13.0",
    "vitest": "^3.2.0",
    "@testing-library/vue": "^8.1.0",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.6.0",
    "@types/node": "^24.0.0"
  }
}
