{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "../../dist-server"
  },
  "include": [
    "server/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "drizzle.config.ts"
  ]
}
